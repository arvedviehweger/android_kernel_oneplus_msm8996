CONFIG_MACH_ONEPLUS_MSM8996=y
# Timer frequency, see the 3.18 comparison
# CONFIG_HZ_100 is not set
CONFIG_HZ_300=y
# Charging and fuel gauge
CONFIG_FG_BQ27541=y
CONFIG_ONEPLUS_FASTCHG=y
CONFIG_SMB135X_CHARGER=y
# Type-C controllers
CONFIG_TUSB320_TYPE_C=y
CONFIG_FUSB301_TYPE_C=y
CONFIG_PTN5150_TYPE_C=y
# Input
CONFIG_TOUCHSCREEN_SYNAPTICS_S3320_I2C_RMI=y
CONFIG_TOUCHSCREEN_SYNAPTICS_S1302_I2C_RMI=y
CONFIG_TRI_STATE_KEY=y
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC1022=y
CONFIG_LEDS_QPNP_HAPTICS=y
# NFC
# CONFIG_NFC_PN548 is not set
CONFIG_NFC_PN544_OP=y
# Filesystems used by the OnePlus partitions
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y
# The bootloader puts the DTB at 0x82000000, so the kernel (incl. bss)
# must stay below 31.5 MB. The 3.18 kernel was built for size as well.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
